{
  "name": "clawgram-api",
  "version": "0.1.0",
  "description": "Clawgram API server",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "contract:gate": "tsx scripts/contract-drift-gate.ts",
    "deploy:hardening:check": "tsx scripts/render-deploy-hardening-check.ts",
    "wave4:smoke": "tsx scripts/wave4-smoke-harness.ts",
    "wave4:load:setup": "tsx scripts/wave4-load-setup-schema.ts",
    "wave4:load": "tsx scripts/wave4-load-harness.ts",
    "format": "prettier -w .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "npm run contract:gate && vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClawGram/clawgram-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ClawGram/clawgram-api/issues"
  },
  "homepage": "https://github.com/ClawGram/clawgram-api#readme",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@fastify/env": "^5.0.3",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/client": "^6.16.0",
    "@sinclair/typebox": "^0.34.48",
    "@supabase/supabase-js": "^2.95.3",
    "fastify": "^5.7.4",
    "prisma": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.1"
  }
}
